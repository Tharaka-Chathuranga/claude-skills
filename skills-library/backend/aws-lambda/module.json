{
  "name": "AWS Lambda",
  "description": "Runtime rules for Node.js Lambda functions: composition-root handlers, client lifetime, retries, idempotency, batching and logging.",
  "detect": {
    "anyDependencies": [
      "@types/aws-lambda",
      "aws-lambda",
      "@aws-lambda-powertools/*",
      "@middy/core",
      "serverless",
      "aws-cdk-lib"
    ]
  },
  "requires": [
    "core/quality",
    "core/design"
  ],
  "placement": [
    "amplify"
  ],
  "skills": {
    "lambda-standards": {
      "detect": {
        "anyOf": [
          {
            "anyFiles": [
              "amplify/functions"
            ]
          },
          {
            "anyDependencies": [
              "@types/aws-lambda",
              "aws-lambda",
              "@aws-lambda-powertools/*",
              "@middy/core",
              "serverless",
              "aws-cdk-lib"
            ]
          }
        ]
      }
    },
    "llm-functions": {
      "detect": {
        "anyDependencies": [
          "openai",
          "@anthropic-ai/sdk",
          "@openrouter/sdk",
          "@ai-sdk/*",
          "ai",
          "langchain",
          "@langchain/*",
          "@aws-sdk/client-bedrock-runtime",
          "@google/genai",
          "@google/generative-ai",
          "@mistralai/mistralai",
          "cohere-ai",
          "groq-sdk"
        ]
      }
    }
  }
}
