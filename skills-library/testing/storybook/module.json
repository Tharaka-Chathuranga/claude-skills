{
  "name": "Storybook",
  "description": "Stories per component state with args, decorators and play-function interaction tests.",
  "detect": {
    "anyOf": [
      {
        "anyFiles": [
          ".storybook"
        ]
      },
      {
        "anyDependencies": [
          "storybook",
          "@storybook/*"
        ]
      }
    ]
  },
  "requires": [
    "frontend/react"
  ]
}
