{
  "name": "Core playbooks",
  "description": "Step-by-step fixes for quality-gate failures: oversized files and import-boundary violations.",
  "detect": {
    "always": true
  },
  "requires": [],
  "skills": {
    "fix-import-boundary": {
      "detect": {
        "anyOf": [
          {
            "anyDependencies": [
              "dependency-cruiser",
              "eslint-plugin-boundaries"
            ]
          },
          {
            "anyFiles": [
              "quality.config.json",
              ".dependency-cruiser.js",
              ".dependency-cruiser.cjs"
            ]
          }
        ]
      }
    }
  }
}
